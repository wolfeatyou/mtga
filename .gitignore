# transient runtime state (rewritten every draft)
.draft_hist.json
.draft_watch.json
.draft_hist_p2.json
.draft_watch_p2.json
.match_live.json

# python bytecode
__pycache__/
*.pyc

# backups (рейтинги воспроизводятся fetch_17l.py; ручные копии в git не нужны)
*.bak
*.bak.json
*_backup_*.json

# 17Lands color-pair caches — regenerated on demand from 17lands.com
cache_17l_*.json

# latency-sim artifacts — regenerated from Player.log by draft_sim.py
sim/sim_player.log
sim/sim_state.json

# per-game generated replay outputs (regenerated by replay_*.py)
replay_report.html
replay_moments.html
game4_review.html

# генерируемые визуальные читшиты и тренажёры — их делают build_*_cheatsheet.py /
# build_hob_images.py, весят сотни КБ (hob — 3.5 МБ), в git им делать нечего
*_cheatsheet.html
draft_training*.html

# quickdraft transient state
.qd_last_*.json

# автосохранённые пулы драфтов — данные, но шумные; трекаем выборочно
# (снять комментарий, если захочется хранить историю пулов в git)
# pools/

# атлас: страница и кэш принтов генерируются build_atlas.py из atlas/{head,body,decks}
# (3.3 МБ и 4 МБ соответственно — в git им делать нечего)
hob_atlas.html
atlas/imgs.json

# свёрнутые публичные датасеты 17Lands — воспроизводятся fetch_17l_games.py за ~20с
# (msh_decks.json.gz это 6.5 МБ производных данных, в git им делать нечего)
games/
logs/
